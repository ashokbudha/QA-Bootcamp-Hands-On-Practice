  "item": [
    {
      "name": "search country by name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var country = pm.response.json().data.objects[0];\n\npm.test(\"status code is 200\",function(){\n    pm.response.to.have.status(200);\n});\n\npm.test(\"name exists\",function (){\n    pm.expect(country.names.common).to.exist;\n});\n\npm.test(\"capital exists\",function(){\n    pm.expect(country.capitals[0].name).to.exist;\n})\n\npm.test(\"population exist\", function(){\n    pm.expect(country.population).to.exist;\n})\n\npm.test(\"currencies exist\",function(){\n    pm.expect(country.currencies[0].name).to.exist;\n})"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "rc_live_5651e30a0db94378a0a7e49f3caba0ec",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.restcountries.com/countries/v5/names.common/nepal",
