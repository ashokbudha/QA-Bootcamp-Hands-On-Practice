  "item": [
    {
      "name": "browse available pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function(){\r\n    pm.response.to.have.status(200);\r\n})\r\n\r\npm.test(\"Array is not empty\", function () {\r\n    pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty;\r\n});\r\n\r\nvar jsonData = pm.response.json();\r\npm.environment.set(\"pet_id\",jsonData[0].id);\r\n\r\npm.test(\"pet id saved\",function(){\r\n    pm.expect(pm.environment.get(\"pet_id\")).to.eql(jsonData[0].id);\r\n})"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{petstore_url}}/pet/findByStatus?status=available",
          "host": [
            "{{petstore_url}}"
          ],
          "path": [
            "pet",
            "findByStatus"
          ],
          "query": [
            {
              "key": "status",
              "value": "available"
            }
          ]
        }
      },
      "response": []
    },
