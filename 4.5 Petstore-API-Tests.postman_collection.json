    {
      "name": "place order for pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function(){\r\n    pm.response.to.have.status(200);\r\n})\r\n\r\nconst responseText = pm.response.text();\r\nconst match = responseText.match(/\"id\"\\s*:\\s*(\\d+)/);\r\nconst orderId = match[1];\r\npm.environment.set(\"order_id\", orderId);\r\n\r\n\r\npm.test(\"Order ID is saved\", function () {\r\n    pm.expect(pm.environment.get(\"order_id\")).to.eql(orderId);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"petId\": {{pet_id}},\r\n    \"quantity\": 1,\r\n    \"shipDate\": \"2026-09-22T12:00:00.000Z\",\r\n    \"status\": \"placed\",\r\n    \"complete\": true\r\n}",
          "options": {
