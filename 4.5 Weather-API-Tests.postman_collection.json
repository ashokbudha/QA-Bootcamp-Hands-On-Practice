  "item": [
    {
      "name": "get weather by city",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Temperature exists\", function () {\r\n    pm.expect(data.main.temp).to.exist;\r\n});\r\n\r\npm.test(\"Humidity exists\", function () {\r\n    pm.expect(data.main.humidity).to.exist;\r\n});\r\n\r\npm.test(\"Weather description exists\", function () {\r\n    pm.expect(data.weather[0].description).to.exist;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{weather_base_url}}?q=Kathmandu&appid={{appid}}&units=metrics",
          "host": [
            "{{weather_base_url}}"
          ],
          "query": [
            {
              "key": "q",
              "value": "Kathmandu"
            },
            {
              "key": "appid",
              "value": "{{appid}}"
            },
            {
              "key": "units",
              "value": "metrics"
            }
          ]
        }
      },
      "response": []
    },
